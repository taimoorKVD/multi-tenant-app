<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EU Social</title>
    <style>
      body {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #0a0f24, #192a56);
        color: white;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      h1 {
        font-size: 4rem;
        letter-spacing: 2px;
        text-align: center;
        margin: 0;
        animation: glow 3s ease-in-out infinite;
        background: linear-gradient(90deg, #00c6ff, #0072ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      @keyframes glow {
        0%, 100% {
          text-shadow: 0 0 10px #00c6ff, 0 0 20px #0072ff;
        }
        50% {
          text-shadow: 0 0 25px #00c6ff, 0 0 45px #0072ff;
        }
      }

      p {
        margin-top: 15px;
        font-size: 1rem;
        color: #b0b0b0;
        letter-spacing: 1px;
        text-align: center;
        font-weight: 300;
      }

      p span {
        color: #00c6ff;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <h1>EU&nbsp;SOCIAL</h1>
    <p>Developed by <span>Kingdom Vision</span></p>
  </body>
</html>
